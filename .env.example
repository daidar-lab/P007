# --- API (lado servidor) ---
DATABASE_URL=postgres://usuario:senha@localhost:5432/comunicados
PORT=3001

# Segredo usado para assinar tokens JWT — TROQUE em produção
JWT_SECRET=dev-secret-change-me

# --- Amazon Bedrock (análise de fotos por IA) ---
# Deixe AWS_ACCESS_KEY_ID vazio para desabilitar a análise (o app salva fotos
# normalmente, só não chama o Bedrock).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Modelo Claude (vision) — use o ID do modelo provisionado na sua conta.
# Exemplos comuns no Bedrock:
#   anthropic.claude-opus-4-5-20250722-v1:0
#   anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL_ID=anthropic.claude-opus-4-5-20250722-v1:0

# --- Front (lado cliente, Vite) ---
# Em dev, deixe vazio: o Vite proxia /api para http://localhost:3001
# Em prod, aponte para a URL pública da API.
VITE_API_BASE=
