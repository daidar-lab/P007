# --- API (lado servidor) ---
DATABASE_URL=postgres://usuario:senha@localhost:5432/comunicados
PORT=3001

# Segredo usado para assinar tokens JWT — TROQUE em produção
JWT_SECRET=dev-secret-change-me

# --- Análise de fotos por IA (Groq) ---
# Deixe GROQ_API_KEY vazio para desabilitar a análise (o app salva fotos
# normalmente, só não chama a API).
# Obtenha sua chave em https://console.groq.com/keys
GROQ_API_KEY=
# Modelo Groq com suporte a visão. Exemplos:
#   meta-llama/llama-4-scout-17b-16e-instruct       (default — rápido e barato)
#   meta-llama/llama-4-maverick-17b-128e-instruct   (maior contexto)
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Front (lado cliente, Vite) ---
# Em dev, deixe vazio: o Vite proxia /api para http://localhost:3001
# Em prod, aponte para a URL pública da API.
VITE_API_BASE=
